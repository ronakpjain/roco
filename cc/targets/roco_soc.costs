# roco SoC instruction costs for roco_cc -O2.
#
# issue is the cycles between independent instructions. The other values are
# dependent-result latencies, except store, branch, and jump, which are the
# pipeline occupancy of instructions that do not produce a register result.
# The compiler scores every instruction in a candidate sequence, including
# the pseudo-instruction expansion of `li`, so a longer shift/add sequence
# wins only when the hardware operation really is more expensive. Update this
# file when the pipeline changes.
#
# Usage:
#   roco_cc -O2 --cost-model ../cc/targets/roco_soc.costs -S -o out.s in.c
#
# RTL references:
#   multiply: one EX/MEM bubble, result forwarded from MEM
#   divide:   iterative radix-four divider, start + prepare + 16 chunks + finish
#   load:     MEM result bypass plus the ID load-use bubble
#   branch:   EX redirect/occupancy (the front end has a BTB)

issue      = 1
arithmetic = 1
shift      = 1
compare    = 1
multiply   = 2
divide     = 20
load       = 2
store      = 1
branch     = 1
jump       = 1

# Data-cache line size for cache-aware global layout.
data_cache_line = 32
